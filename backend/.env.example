# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assessment_portal?schema=public"

# Redis (session cache / rate limiting / future job queues)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Seed / demo accounts (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@institution.edu"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_FACULTY_EMAIL="faculty@institution.edu"
SEED_FACULTY_PASSWORD="Faculty@12345"
SEED_STUDENT_PASSWORD="Student@12345"
